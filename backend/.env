# Get a free key at https://build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=Your-api-key-here

# Any chat model available on build.nvidia.com works here. Recommended defaults
# (plain instruct models, no chain-of-thought overhead - faster and more reliable
# for structured extraction than reasoning models like the Nemotron 3 family):
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# For richer narration quality, swap to: meta/llama-3.1-70b-instruct
# Note: nvidia/llama-3.1-nemotron-70b-instruct is DEPRECATED as of 2026 - don't use it.

# If you do use a reasoning model (Nemotron 3 Nano/Super/Ultra, GPT-OSS, etc.),
# this suppresses its visible chain-of-thought so it doesn't eat the token budget
# before answering. Leave as default (true) unless you have a specific reason not to.
NVIDIA_DISABLE_THINKING=true

# Embedding model used for RAG (catalog retrieval).
# NVIDIA's free-tier catalog changes frequently - nv-embedqa-e5-v5 (the old default
# here) has been retired. Reliable way to find a working one right now:
#   1. Go to https://build.nvidia.com/models
#   2. Filter by "Text-to-Embedding" + "Free Endpoint"
#   3. Open any model, copy the exact id from its code sample's model="..." line
# Worth trying first (unconfirmed live as of this writing, catalog moves fast):
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

PORT=8787
